    "test:unit": "node --test \"src/domain/**/*.test.ts\" \"src/server/**/*.test.ts\" \"src/lib/**/*.test.ts\"",
    "test:db": "node scripts/db-test.mjs",
    "typecheck": "tsc --noEmit",
