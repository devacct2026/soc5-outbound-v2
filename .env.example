# SOC5 Outbound v2: server-only configuration. Copy to .env.local (git-ignored).
# Use a LOCAL or DISPOSABLE Supabase project only. The legacy SUPABASE_* names
# used by the original application are intentionally ignored by v2.
SOC5_SUPABASE_URL=
SOC5_SUPABASE_ANON_KEY=
SOC5_SUPABASE_SERVICE_ROLE_KEY=      # never expose to the browser / NEXT_PUBLIC_*

# Feature flags (all default off). SeaTalk approval stays off until the provider
# contract is verified in a sandbox (docs/backend/10-implementation-readiness.md).
SOC5_FEATURE_SEATALK_APPROVAL=false
SOC5_FEATURE_SEATALK_ALERTS=false
SOC5_FEATURE_GOOGLE_SHEETS=false

# SeaTalk Open Platform app (Approval Center + Login with SeaTalk). All values server-only.
# Contract status: create/get approval item, event-callback signature and code2employee are from the vendored OFFICIAL
# pages; the app-access-token response fields and the approve/reject callback signature are LIVE-UNVERIFIED
# (docs/parity-matrix.md). Verify in a SeaTalk sandbox before enabling SOC5_FEATURE_SEATALK_APPROVAL.
SOC5_SEATALK_APP_ID=
SOC5_SEATALK_APP_SECRET=
SOC5_SEATALK_BASE_URL=https://openapi.seatalk.io
SOC5_SEATALK_APPROVAL_TOKEN_SECRET=      # >= 32 random chars; signs the one-time per-assignment callback token
SOC5_SEATALK_APPROVE_CALLBACK_URL=       # https://<api>/api/v1/integrations/seatalk/approval/approve
SOC5_SEATALK_REJECT_CALLBACK_URL=        # https://<api>/api/v1/integrations/seatalk/approval/reject
SOC5_SEATALK_CALLBACK_SECRET=            # approve/reject callback verification (LIVE-UNVERIFIED scheme)
SOC5_SEATALK_CALLBACK_MAX_SKEW_SECONDS=300
SOC5_SEATALK_SIGNING_SECRET=             # official event-callback signing secret (verification handshake)
SOC5_SEATALK_SYNC_MODE=off               # off | recreate (re-post item with final state; provider upsert semantics unverified)
SOC5_PRESENCE_ACTIVE_SECONDS=60          # sandbox default (SEA-6); also app_settings.presence_freshness_seconds
SOC5_SEATALK_LOGIN_REDIRECT_URI=         # https://<api>/api/v1/auth/seatalk/callback (registered in the SeaTalk console)
SOC5_SEATALK_SDK_URL=https://static.cdn.haiserve.com/seatalk/client/shared/sop/auth.js

# Sign-in flows: allow-listed web origin is the ONLY redirect target; state secret signs the SeaTalk login state.
SOC5_AUTH_STATE_SECRET=                  # >= 32 random chars

# Google Apps Script syncs (HMAC-SHA256 over "<timestamp>.<body>", headers x-sync-source/x-sync-timestamp/x-sync-signature)
SOC5_INTRADAY_SYNC_SECRET=
SOC5_CLUSTER_SYNC_SECRET=

# Realtime (browser, PUBLIC by design: RLS protects the data; never put the service-role key here)
NEXT_PUBLIC_SOC5_REALTIME_URL=
NEXT_PUBLIC_SOC5_REALTIME_ANON_KEY=

# Worker (npm run worker) and Google Sheets mirror
WORKER_INTERVAL_SECONDS=15
GOOGLE_SA_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Requests

# NestJS API (npm run start:api) and BullMQ scheduling (SOC5_QUEUE=bullmq needs a LOCAL/disposable Redis)
SOC5_API_PORT=4000
SOC5_WEB_ORIGIN=http://localhost:3000
SOC5_QUEUE=db
SOC5_REDIS_URL=redis://127.0.0.1:6379
